# =========================================================================
# DIGIVOTING PLATFORM - LOCAL CONFIGURATION ENVS
# =========================================================================
# Copy this file to '.env' in this folder and configure variables as needed.

DEBUG=True
SECRET_KEY=django-insecure-mock-key-for-development-purposes
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# -------------------------------------------------------------------------
# DATABASE CONFIGURATION (Supabase PostgreSQL Connection Pooler)
# -------------------------------------------------------------------------
# SQLite is NOT supported in this project. You must supply a valid DATABASE_URL.
# For concurrent-voting safety and connection limit safety, you MUST use the
# Supabase Transaction Pooler connection string (port 6543, pgbouncer).
#
# Steps:
# 1. Go to Supabase Dashboard -> Project Settings -> Database -> Connection URI.
# 2. Select Mode: "Transaction" (port 6543).
# 3. Copy the Connection URI.
# 4. Set DATABASE_URL to that URI and replace [PASSWORD] with your actual DB password.
#
# Example connection string:
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# -------------------------------------------------------------------------
# SUPABASE STORAGE CONFIGURATION (Optional - for storing face audits as files)
# -------------------------------------------------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=election-assets
